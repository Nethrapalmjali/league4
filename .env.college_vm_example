# =============================================================================
# GM League Season 4 - College Windows server (SQLite, no Supabase)
# =============================================================================
# start_server.bat copies this to .env on first run. Fill in the blanks in .env
# on the server itself - never commit real values.

# --- Core ---
SECRET_KEY=
FLASK_DEBUG=False
# True when the site is reached over https (Cloudflare Tunnel / gmleague.online).
# Set False only if you must log in to admin over plain http://<server-ip>:5000.
SESSION_COOKIE_SECURE=True
MAX_UPLOAD_MB=8
HOST=0.0.0.0
PORT=5000
SITE_URL=https://gmleague.online

# --- Admin ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Database: leave DATABASE_URL empty -> SQLite at instance\league.db ---
DATABASE_URL=

# --- Storage: leave Supabase empty -> uploads saved in static\ on this server ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# --- Render keep-alive pinger: not needed on a always-on server ---
KEEP_ALIVE_ENABLED=false

# --- Email (Gmail SMTP needs an App Password) ---
MAIL_ENABLED=True
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME="GM League Season 4"
