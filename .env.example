# =============================================================================
# GM League Season 4 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace the values with your actual configuration.

# --- Security & Core Flask ---
SECRET_KEY=replace_with_a_random_64_character_string_here
FLASK_DEBUG=False
SESSION_COOKIE_SECURE=True
MAX_UPLOAD_MB=8

# --- Admin Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password_here
# Optional: Use a hashed password instead of plaintext:
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...

# --- Database ---
# Local SQLite default:
DATABASE_URL=sqlite:///instance/league.db
# Or Hosted PostgreSQL (Supabase / Render / Neon):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# --- Render 15-Second Keep-Alive Pinger ---
# If running on Render, set this to your public onrender.com domain:
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
# PING_INTERVAL=15
# KEEP_ALIVE_ENABLED=true

# --- SMTP Email Configuration (Works locally and on hosts where SMTP is open) ---
MAIL_ENABLED=True
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
# For Gmail, MAIL_PASSWORD must be a 16-character Google App Password:
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
MAIL_USERNAME=nethrapalmjali21@gmail.com
MAIL_PASSWORD=wzaziqufonusdtmu
MAIL_SENDER_EMAIL=nethrapalmjali21@gmail.com
MAIL_SENDER_NAME="GM League Season 4"
MAIL_ADMIN_BCC=

# --- Cloud HTTP Email API (CRITICAL for Render Free Tier & Serverless) ---
# Notice: Render Free Tier blocks outbound SMTP traffic on ports 25, 465, and 587.
# To send emails seamlessly on Render Free Tier via HTTPS (Port 443), obtain a free API key:
# Option A: Resend (https://resend.com - 3,000 free emails/mo):
# RESEND_API_KEY=re_123456789...
# RESEND_FROM="GM League Season 4 <onboarding@resend.dev>"  # or your verified domain
# Option B: Brevo (https://brevo.com - 300 free emails/day):
# BREVO_API_KEY=xkeysib-123456789...

